{
  "schemaVersion": "1.0.0",
  "entities": {
    "User": {
      "name": "User",
      "path": "/users/{userId}",
      "description": "User profile with role, contact info, and status",
      "fields": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID",
          "required": true
        },
        "name": {
          "type": "string",
          "description": "User's full name",
          "required": true
        },
        "username": {
          "type": "string",
          "description": "Unique username in lowercase",
          "required": true
        },
        "email": {
          "type": "string",
          "description": "User's email address",
          "required": true
        },
        "role": {
          "type": "string",
          "description": "User role ('admin' or 'user')",
          "required": true,
          "validation": "role in ['admin', 'user']"
        },
        "status": {
          "type": "string",
          "description": "Account status ('Active' or 'Inactive')",
          "required": true,
          "default": "Active"
        },
        "phone": {
          "type": "string",
          "description": "Phone number",
          "required": false
        },
        "address": {
          "type": "string",
          "description": "Address",
          "required": false
        },
        "createdAt": {
          "type": "timestamp",
          "description": "Creation timestamp",
          "required": true
        },
        "lastLoginAt": {
          "type": "timestamp",
          "description": "Last login timestamp",
          "required": false
        }
      }
    },
    "UsernameLookup": {
      "name": "UsernameLookup",
      "path": "/usernames/{username}",
      "description": "Lookup table mapping lowercase unique username to uid and email",
      "fields": {
        "username": {
          "type": "string",
          "description": "Unique username in lowercase",
          "required": true
        },
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "required": true
        },
        "email": {
          "type": "string",
          "description": "Email associated with the username",
          "required": true
        },
        "role": {
          "type": "string",
          "description": "Role associated with the username",
          "required": true
        },
        "createdAt": {
          "type": "timestamp",
          "description": "Creation timestamp",
          "required": true
        }
      }
    }
  },
  "indexes": []
}
